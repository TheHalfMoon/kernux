{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernux.dev/schema/krp/v1",
  "title": "Kernux Runtime Protocol v1 Core Contracts",
  "description": "Authoritative provider-neutral schema source for P01 core generated contracts.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "EntityKind": {
      "type": "string",
      "enum": ["project", "task", "work_unit", "run", "agent_session", "runtime", "artifact", "evidence", "event"]
    },
    "ConsequenceClass": {
      "type": "string",
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3",
        "C4"
      ]
    },
    "ContactState": {
      "type": "string",
      "enum": ["connected", "degraded", "disconnected"]
    },
    "ExecutionState": {
      "type": "string",
      "enum": ["live", "exited", "unverifiable"]
    },
    "SideEffectCertainty": {
      "type": "string",
      "enum": ["definitely_not_started", "operation_known", "may_have_started", "not_applicable"]
    },
    "RetryGuidance": {
      "type": "string",
      "enum": ["retry_request", "reconcile_operation", "new_operation_if_still_authorized", "do_not_retry"]
    },
    "EvidenceSourceClass": {
      "type": "string",
      "enum": ["machine", "external_service", "human_review", "agent_report", "imported"]
    },
    "RedactionState": {
      "type": "string",
      "enum": ["none", "excluded", "transformed"]
    },
    "StreamOwnerKind": {
      "type": "string",
      "enum": ["project", "task", "run", "runtime"]
    },
    "ProtocolContract": {
      "type": "string",
      "enum": ["krp/1"]
    },
    "CapabilityVersion": {
      "type": "string",
      "enum": ["1"]
    },
    "UuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ResourceMatch": {
      "type": "string",
      "enum": [
        "exact",
        "subtree"
      ]
    },
    "CancellationOutcome": {
      "type": "string",
      "enum": [
        "accepted",
        "already_terminal",
        "not_cancellable",
        "unknown_operation",
        "denied",
        "unverifiable"
      ]
    },
    "ErrorCategory": {
      "type": "string",
      "enum": [
        "invalid_request",
        "protocol_mismatch",
        "capability_unavailable",
        "authorization_denied",
        "resource_invalid",
        "operation_conflict",
        "operation_unknown",
        "operation_unverifiable",
        "operation_not_cancellable",
        "runtime_unavailable",
        "runtime_revoked",
        "timeout",
        "internal"
      ]
    },
    "SubjectScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run"
      ],
      "properties": {
        "run": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "agent_session": {
          "$ref": "#/$defs/CanonicalRef"
        }
      }
    },
    "DiagnosticField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "CanonicalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/EntityKind"
        },
        "id": {
          "$ref": "#/$defs/UuidV7"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "ConstraintSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "allowed_roots": { "type": "array", "items": { "type": "string" } },
        "network_hosts": { "type": "array", "items": { "type": "string" } },
        "max_bytes": { "type": "integer", "minimum": 0 },
        "max_duration_ms": { "type": "integer", "minimum": 0 },
        "max_uses": { "type": "integer", "minimum": 1 }
      }
    },
    "CapabilityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "subject_scope",
        "action",
        "resource_uri",
        "runtime",
        "requested_constraints",
        "provenance_event_ids"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "subject_scope": {
          "$ref": "#/$defs/SubjectScope"
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
        },
        "resource_uri": {
          "type": "string",
          "pattern": "^kernux://"
        },
        "runtime": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "requested_constraints": {
          "$ref": "#/$defs/ConstraintSet"
        },
        "provenance_event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UuidV7"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "Grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id",
        "subject_scope",
        "action",
        "resource_uri",
        "resource_match",
        "runtime",
        "constraints",
        "consequence_ceiling",
        "issuer_authority",
        "policy_revision",
        "issued_at",
        "not_before",
        "expires_at",
        "max_uses",
        "delegation_depth"
      ],
      "properties": {
        "grant_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "subject_scope": {
          "$ref": "#/$defs/SubjectScope"
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
        },
        "resource_uri": {
          "type": "string",
          "pattern": "^kernux://"
        },
        "resource_match": {
          "$ref": "#/$defs/ResourceMatch"
        },
        "runtime": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "constraints": {
          "$ref": "#/$defs/ConstraintSet"
        },
        "consequence_ceiling": {
          "$ref": "#/$defs/ConsequenceClass"
        },
        "issuer_authority": {
          "type": "string"
        },
        "policy_revision": {
          "type": "integer",
          "minimum": 1
        },
        "issued_at": {
          "type": "string"
        },
        "not_before": {
          "type": "string"
        },
        "expires_at": {
          "type": "string"
        },
        "max_uses": {
          "type": "integer",
          "minimum": 1
        },
        "delegation_depth": {
          "type": "integer",
          "minimum": 0
        },
        "parent_grant_id": {
          "$ref": "#/$defs/UuidV7"
        }
      }
    },
    "RuntimeCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "version",
        "features"
      ],
      "properties": {
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
        },
        "version": {
          "$ref": "#/$defs/CapabilityVersion"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "RuntimeDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "protocol_contract",
        "capabilities",
        "features",
        "observation_generation",
        "observed_at"
      ],
      "properties": {
        "runtime": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "protocol_contract": {
          "$ref": "#/$defs/ProtocolContract"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuntimeCapability"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observation_generation": {
          "type": "integer",
          "minimum": 1
        },
        "observed_at": {
          "type": "string"
        }
      }
    },
    "RuntimeContactObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "contact_state",
        "observation_generation",
        "observed_at"
      ],
      "properties": {
        "runtime": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "contact_state": {
          "$ref": "#/$defs/ContactState"
        },
        "observation_generation": {
          "type": "integer",
          "minimum": 1
        },
        "observed_at": {
          "type": "string"
        }
      }
    },
    "OperationStart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "operation_id",
        "subject_scope",
        "action",
        "resource_uri",
        "runtime",
        "constraints",
        "payload_sha256",
        "protocol_contract",
        "capability_version"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "operation_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "subject_scope": {
          "$ref": "#/$defs/SubjectScope"
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
        },
        "resource_uri": {
          "type": "string",
          "pattern": "^kernux://"
        },
        "runtime": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "constraints": {
          "$ref": "#/$defs/ConstraintSet"
        },
        "payload_sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "protocol_contract": {
          "$ref": "#/$defs/ProtocolContract"
        },
        "capability_version": {
          "$ref": "#/$defs/CapabilityVersion"
        }
      }
    },
    "OperationObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "runtime",
        "observation_generation",
        "execution_state",
        "observed_at"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "runtime": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "observation_generation": {
          "type": "integer",
          "minimum": 1
        },
        "execution_state": {
          "$ref": "#/$defs/ExecutionState"
        },
        "termination_cause": {
          "type": "string"
        },
        "observed_at": {
          "type": "string"
        }
      }
    },
    "CancelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "operation_id"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "operation_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "CancelResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "operation_id",
        "outcome"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "operation_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "outcome": {
          "$ref": "#/$defs/CancellationOutcome"
        }
      }
    },
    "RuntimeError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "category",
        "message",
        "request_id",
        "retry_guidance",
        "side_effect_certainty"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "operation_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "retry_guidance": {
          "$ref": "#/$defs/RetryGuidance"
        },
        "side_effect_certainty": {
          "$ref": "#/$defs/SideEffectCertainty"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiagnosticField"
          }
        },
        "provider_diagnostic": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiagnosticField"
          }
        }
      }
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "role"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "role": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "StreamRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_kind", "owner"],
      "properties": {
        "owner_kind": { "$ref": "#/$defs/StreamOwnerKind" },
        "owner": { "$ref": "#/$defs/CanonicalRef" }
      }
    },
    "EventCorrelations": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "project": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "task": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "work_unit": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "run": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "agent_session": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "runtime": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "artifact": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "evidence": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "grant_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "capability_request_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "protocol_request_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "operation_id": {
          "$ref": "#/$defs/UuidV7"
        }
      }
    },
    "EventLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caused_by",
        "derived_from"
      ],
      "properties": {
        "caused_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UuidV7"
          }
        },
        "derived_from": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UuidV7"
          }
        },
        "supersedes": {
          "$ref": "#/$defs/UuidV7"
        },
        "forked_from": {
          "$ref": "#/$defs/UuidV7"
        },
        "checkpoint_of": {
          "$ref": "#/$defs/UuidV7"
        }
      }
    },
    "Redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "affected_roles"],
      "properties": {
        "state": { "$ref": "#/$defs/RedactionState" },
        "affected_roles": { "type": "array", "items": { "type": "string" } },
        "reason_class": { "type": "string" },
        "policy_ref": { "type": "string" },
        "policy_version": { "type": "string" },
        "source_artifact": { "$ref": "#/$defs/ArtifactRef" },
        "transformed_artifact": { "$ref": "#/$defs/ArtifactRef" }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "contract_version",
        "stream",
        "stream_seq",
        "producer",
        "recorded_at",
        "correlations",
        "lineage",
        "artifact_refs",
        "sensitivity",
        "redaction"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "event_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "contract_version": {
          "$ref": "#/$defs/ProtocolContract"
        },
        "stream": {
          "$ref": "#/$defs/StreamRef"
        },
        "stream_seq": {
          "type": "integer",
          "minimum": 1
        },
        "previous_event_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "producer": {
          "type": "string"
        },
        "occurred_at": {
          "type": "string"
        },
        "recorded_at": {
          "type": "string"
        },
        "correlations": {
          "$ref": "#/$defs/EventCorrelations"
        },
        "lineage": {
          "$ref": "#/$defs/EventLineage"
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "sensitivity": {
          "type": "string"
        },
        "redaction": {
          "$ref": "#/$defs/Redaction"
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "claim",
        "subject_bindings",
        "source_class",
        "observer",
        "observed_event_ids",
        "artifact_refs",
        "result",
        "limitations",
        "recorded_by_event_id",
        "sensitivity",
        "redaction"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "claim": {
          "type": "string"
        },
        "subject_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CanonicalRef"
          }
        },
        "source_class": {
          "$ref": "#/$defs/EvidenceSourceClass"
        },
        "observer": {
          "type": "string"
        },
        "observed_event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UuidV7"
          }
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "runtime_context": {
          "$ref": "#/$defs/CanonicalRef"
        },
        "operation_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "implementation_revision": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recorded_by_event_id": {
          "$ref": "#/$defs/UuidV7"
        },
        "sensitivity": {
          "type": "string"
        },
        "redaction": {
          "$ref": "#/$defs/Redaction"
        }
      }
    }
  }
}
