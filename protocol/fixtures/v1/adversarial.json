{
  "schema": "kernux.krp.adversarial/v1",
  "required_invariant_ids": [
    "ADV-01",
    "ADV-02",
    "ADV-03",
    "ADV-04",
    "ADV-05",
    "ADV-06",
    "ADV-07",
    "ADV-08",
    "ADV-09",
    "ADV-10",
    "ADV-11",
    "ADV-12",
    "ADV-13",
    "ADV-14",
    "ADV-15",
    "ADV-16",
    "ADV-17",
    "ADV-18",
    "ADV-19",
    "ADV-20"
  ],
  "policy_cases": [
    {
      "id": "ADV-01",
      "rule": "contact_loss_preserves_execution",
      "input": {
        "contact_state": "disconnected",
        "execution_state": "live"
      },
      "expected": {
        "execution_state": "live"
      }
    },
    {
      "id": "ADV-02",
      "rule": "timeout_preserves_execution",
      "input": {
        "timeout_kind": "heartbeat",
        "execution_state": "live"
      },
      "expected": {
        "execution_state": "live"
      }
    },
    {
      "id": "ADV-03",
      "rule": "cancellation_acceptance_preserves_execution",
      "input": {
        "cancellation_outcome": "accepted",
        "execution_state": "live"
      },
      "expected": {
        "execution_state": "live"
      }
    },
    {
      "id": "ADV-04",
      "rule": "cancellation_transport_loss_is_unverifiable",
      "input": {
        "cancellation_transport": "lost"
      },
      "expected": {
        "cancellation_state": "unverifiable"
      }
    },
    {
      "id": "ADV-05",
      "rule": "stale_observation_is_rejected",
      "input": {
        "current_generation": 9,
        "current_state": "live",
        "incoming_generation": 8,
        "incoming_state": "exited"
      },
      "expected": {
        "disposition": "stale_rejected",
        "execution_state": "live"
      }
    },
    {
      "id": "ADV-06",
      "rule": "same_fingerprint_deduplicates",
      "input": {
        "operation_id": "01890f00-0000-7000-8000-000000000009",
        "stored_fingerprint": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "incoming_fingerprint": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expected": {
        "disposition": "reconcile_existing",
        "execute": false
      }
    },
    {
      "id": "ADV-07",
      "rule": "fingerprint_conflict_rejects",
      "input": {
        "operation_id": "01890f00-0000-7000-8000-000000000009",
        "stored_fingerprint": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "incoming_fingerprint": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "expected": {
        "disposition": "operation_conflict",
        "execute": false
      }
    },
    {
      "id": "ADV-08",
      "rule": "ambiguous_start_preserves_operation_id",
      "input": {
        "operation_id": "01890f00-0000-7000-8000-000000000009",
        "side_effect_certainty": "may_have_started"
      },
      "expected": {
        "operation_id": "01890f00-0000-7000-8000-000000000009",
        "retry_guidance": "reconcile_operation"
      }
    },
    {
      "id": "ADV-09",
      "rule": "may_have_started_forbids_fresh_operation",
      "input": {
        "operation_id": "01890f00-0000-7000-8000-000000000009",
        "side_effect_certainty": "may_have_started"
      },
      "expected": {
        "create_fresh_operation": false,
        "operation_id": "01890f00-0000-7000-8000-000000000009"
      }
    },
    {
      "id": "ADV-10",
      "rule": "unknown_retry_guidance_reconciles",
      "input": {
        "retry_guidance": "future_retry_mode",
        "side_effect_certainty": "may_have_started"
      },
      "expected": {
        "blind_retry": false,
        "retry_guidance": "reconcile_operation"
      }
    },
    {
      "id": "ADV-11",
      "rule": "authority_requires_intersection",
      "input": {
        "advertised_capability": true,
        "grant": false,
        "policy_allows": false,
        "negotiated_capability": true
      },
      "expected": {
        "authorized": false
      }
    },
    {
      "id": "ADV-12",
      "rule": "authority_requires_intersection",
      "input": {
        "advertised_capability": true,
        "grant": true,
        "policy_allows": true,
        "negotiated_capability": false
      },
      "expected": {
        "authorized": false
      }
    },
    {
      "id": "ADV-13",
      "rule": "runtime_type_does_not_imply_capability",
      "input": {
        "runtime_type": "local",
        "requested_action": "files.write",
        "advertised_actions": []
      },
      "expected": {
        "authorized": false
      }
    },
    {
      "id": "ADV-14",
      "rule": "reconnect_does_not_restore_grant",
      "input": {
        "reconnected": true,
        "grant_status": "revoked"
      },
      "expected": {
        "authorized": false
      }
    },
    {
      "id": "ADV-15",
      "rule": "trust_identity_change_is_new_runtime",
      "input": {
        "enrolled_identity": "host-key-a",
        "observed_identity": "host-key-b"
      },
      "expected": {
        "same_runtime": false
      }
    },
    {
      "id": "ADV-16",
      "rule": "provider_diagnostic_cannot_lower_uncertainty",
      "input": {
        "canonical_side_effect_certainty": "may_have_started",
        "provider_diagnostic": "definitely_not_started"
      },
      "expected": {
        "side_effect_certainty": "may_have_started"
      }
    },
    {
      "id": "ADV-17",
      "rule": "request_timeout_is_not_operation_failure",
      "input": {
        "timeout_kind": "request",
        "authoritative_execution_observation": null
      },
      "expected": {
        "execution_state": "unverifiable"
      }
    },
    {
      "id": "ADV-18",
      "rule": "controller_cache_loss_is_not_exit",
      "input": {
        "controller_cache": "lost",
        "authoritative_exit_observation": false
      },
      "expected": {
        "execution_state": "unverifiable"
      }
    },
    {
      "id": "ADV-19",
      "rule": "equal_generation_conflict_fails",
      "input": {
        "current_generation": 9,
        "current_state": "live",
        "incoming_generation": 9,
        "incoming_state": "exited"
      },
      "expected": {
        "disposition": "invariant_conflict"
      }
    },
    {
      "id": "ADV-20",
      "rule": "unknown_operation_preserves_uncertainty",
      "input": {
        "operation_lookup": "unknown",
        "persistence_guarantee_definitely_not_started": false
      },
      "expected": {
        "retry_guidance": "reconcile_operation",
        "side_effect_certainty": "may_have_started"
      }
    }
  ],
  "wire_cases": [
